{
  "name": "ecozyon-tech",
  "version": "1.0.0",
  "description": "Corporate website for Ecozyon Tech (React + Vite + Tailwind, Feature-Sliced Design).",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.mjs",
    "build:spa": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:geo": "node scripts/build-geo.mjs",
    "seed:posts": "node scripts/seed-posts.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:ui": "playwright test --ui",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "keywords": [
    "react",
    "vite",
    "tailwindcss",
    "feature-sliced-design",
    "prerender",
    "three.js",
    "portfolio"
  ],
  "author": "Ecozyon Tech",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "three": "^0.184.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "topojson-client": "^3.1.0",
    "vite": "^8.0.13",
    "vitest": "^3.2.4"
  }
}
